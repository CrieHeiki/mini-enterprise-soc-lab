<group name="soclab,">

  <rule id="100410" level="10">
    <decoded_as>json</decoded_as>
    <field name="soclab_detection" type="pcre2">^ENDPOINT_MULTISTAGE_POWERSHELL$</field>
    <description>SOC-LAB: Correlated PowerShell execution, network activity and persistence</description>
    <group>soclab_endpoint,</group>
  </rule>

  <rule id="100411" level="12">
    <decoded_as>json</decoded_as>
    <field name="soclab_detection" type="pcre2">^AD_PRIVILEGE_ESCALATION$</field>
    <description>SOC-LAB: New domain account assigned Domain Admin privileges</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>soclab_identity,</group>
  </rule>

</group>
